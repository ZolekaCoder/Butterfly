# Copy this file to .env at the repo root and fill in real values.
# Never commit the real .env file.

# --- Model provider (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=

# --- Model configuration ---
# Any model id from @mozaik-ai/core's supported list (anthropic/openai/gemini/deepseek).
# claude-haiku-4-5 is the default: fast + cheap enough to run 4 agents concurrently live.
MOZAIK_MODEL=claude-haiku-4-5

# --- Server ---
PORT=8787

# Comma-separated list of allowed browser origins for the API, e.g.
# https://butterfly.vercel.app,https://butterfly.example.com
# Leave unset for local dev — that keeps the original permissive (any-origin)
# behavior. In production, set this to your deployed frontend's exact
# origin(s); the server then rejects cross-origin browser requests from
# anywhere else.
ALLOWED_ORIGINS=

# Hard ceiling on intervention-triggered agent runs per rolling hour,
# server-wide (on top of the built-in per-IP rate limit) — the backstop
# against a public deployment draining the Anthropic balance. Optional;
# defaults to 200 if unset.
MAX_INTERVENTIONS_PER_HOUR=200

# --- Web (Vite) ---
# Base URL the frontend uses to reach the server's HTTP + SSE endpoints.
# In production this must be the deployed backend's public URL, e.g.
# https://butterfly-server.onrender.com — set as a Vercel environment
# variable (build-time), not here.
VITE_API_URL=http://localhost:8787
