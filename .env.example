# Copy this file to .env at the repo root and fill in real values.
# Never commit the real .env file.

# --- Model provider (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=

# --- Model configuration ---
# Any model id from @mozaik-ai/core's supported list (anthropic/openai/gemini/deepseek).
# claude-haiku-4-5 is the default: fast + cheap enough to run 4 agents concurrently live.
MOZAIK_MODEL=claude-haiku-4-5

# --- Server ---
PORT=8787

# --- Web (Vite) ---
# Base URL the frontend uses to reach the server's HTTP + SSE endpoints.
VITE_API_URL=http://localhost:8787
